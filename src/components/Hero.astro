---
import { Image } from 'astro:assets';
import bgImage from '@images/bg-hero.webp';
import heroCelu from '@images/heroCelu.webp';
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#79D8DF] to-white"
  aria-label="Hero principal"
>
  <!-- Fondo -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={bgImage}
      alt=""
      widths={[768, 1024, 1440, 1920]}
      sizes="100vw"
      quality={78}
      class="absolute inset-0 h-full w-full object-cover opacity-40 lg:opacity-100"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      format="webp"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-transparent to-white/40"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-white/70 via-white/10 to-transparent lg:from-white/40"></div>
  </div>

  <!-- Blobs decorativos -->
  <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-white/40 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 right-0 h-96 w-96 rounded-full bg-brand-100/50 blur-3xl" aria-hidden="true"></div>

  <div class="container-page relative z-10 grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-8 lg:py-24">
    <!-- Texto -->
    <div class="lg:col-span-7 lg:order-1 flex flex-col justify-center text-center lg:text-left">
      <h1 class="text-hero text-ink-soft text-balance !font-medium tracking-tight">
        Landing Page Rápida y Económica
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft mx-auto lg:mx-0">
        <strong class="font-semibold text-ink">Landing page económica desde $100.000</strong>
        con diseño profesional, optimizada para Google y entrega en 48 horas. Ideal para captar
        clientes y generar conversiones efectivas. Experiencia en Astro.js y WordPress: combinación perfecta para rapidez y posicionamiento SEO.
      </p>

      <!-- Slider de mensajes -->
      <div class="mt-6 relative h-20 overflow-hidden mx-auto lg:mx-0 max-w-2xl">
        <div id="hero-slider">
          <p class="slider-item text-2xl font-bold text-accent absolute w-full text-center lg:text-left transition-opacity duration-1000 ease-in-out opacity-100">
            ¿Quieres una landing rápida como esta? ⚡ Carga en menos de 1 segundo
          </p>
          <p class="slider-item text-2xl font-bold text-accent absolute w-full text-center lg:text-left transition-opacity duration-1000 ease-in-out opacity-0">
            Tu puerta de entrada al éxito digital — Rápida, Económica y Profesional
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
        <a href="#contacto" class="btn-primary">Solicitar Cotización</a>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-muted lg:justify-start">
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-accent" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
          Entrega en 48 horas
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          Respuesta el mismo día
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
          +200 proyectos · 13 años de experiencia
        </span>
      </div>
    </div>

    <!-- Imagen producto -->
    <div class="lg:col-span-5 lg:order-2 relative flex items-end justify-center">
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
        <div class="h-4/5 w-4/5 rounded-full bg-white/50 blur-3xl"></div>
      </div>
      <Image
        src={heroCelu}
        alt="Diseño de Landing Pages Chile"
        width={560}
        height={720}
        quality={80}
        loading="eager"
        class="relative w-auto max-w-[92%] md:max-w-[85%] lg:max-w-[125%] h-auto object-contain transition-transform duration-500 ease-out hover:-translate-y-3"
        format="webp"
      />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const slides = document.querySelectorAll('.slider-item');
    let currentSlide = 0;

    function nextSlide() {
      // Ocultar slide actual
      slides[currentSlide].style.opacity = '0';
      
      // Siguiente slide
      currentSlide = (currentSlide + 1) % slides.length;
      
      // Mostrar nuevo slide
      slides[currentSlide].style.opacity = '1';
    }

    // Cambiar cada 4 segundos
    setInterval(nextSlide, 4000);
  })();
</script>
